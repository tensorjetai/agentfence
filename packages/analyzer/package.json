{
  "name": "@tensorjetai/agentfence",
  "version": "0.1.2",
  "description": "Deterministic static security analyzer for AI agents, MCP servers, and GitHub Actions workflows",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentfence": "./dist/cli-entry.js",
    "agentfence-cli": "./dist/cli-entry.js"
  },
  "files": [
    "dist/cli-entry.js",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": [
        "./src/index.ts",
        "./dist/src/index.d.ts"
      ],
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@agentfence/policy": "workspace:*",
    "esbuild": "^0.25.12",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
